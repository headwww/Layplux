{
  "name": "layplux",
  "version": "0.0.1",
  "description": "IDE-like window system and plugin framework for the web",
  "type": "module",
  "main": "./dist/layplux.umd.js",
  "module": "./dist/layplux.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/layplux.es.js",
      "require": "./dist/layplux.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "eventemitter2": "^6.4.9"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.2"
  }
}
