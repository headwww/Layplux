{
  "name": "layplux",
  "version": "2.0.12",
  "description": "IDE-like window system and plugin framework for the web",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./scss": {
      "sass": "./src/style/layplux.scss",
      "default": "./src/style/layplux.scss"
    }
  },
  "publishConfig": {
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/esm/index.mjs",
        "require": "./dist/cjs/index.cjs",
        "default": "./dist/esm/index.mjs"
      },
      "./style.css": "./dist/style/index.css",
      "./scss": {
        "sass": "./dist/style/layplux.scss",
        "default": "./dist/style/layplux.scss"
      }
    },
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "gulp --gulpfile ../../build-script/gulpfile.js build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "eventemitter2": "^6.4.9"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
