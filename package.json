{
  "name": "arvin-layplux",
  "version": "1.0.0",
  "private": true,
  "description": "IDE-like window system and plugin framework for the web",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "scripts": {
    "dev": "pnpm -r --filter @layplux/playground dev",
    "build": "pnpm -C build-script build",
    "test": "pnpm -r --filter layplux test",
    "preview": "pnpm -r --filter @layplux/playground preview",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint . --fix && eslint . --fix",
    "lint:style": "stylelint \"**/*.{css,scss,vue}\"",
    "lint:style:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
    "lint:all": "npm run lint && npm run lint:style",
    "lint:all:fix": "npm run lint:fix && npm run lint:style:fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-plugin-oxlint": "^1.66.0",
    "eslint-plugin-vue": "^10.9.1",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "postcss": "^8.5.15",
    "postcss-html": "^1.8.1",
    "sass-embedded": "^1.100.0",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.12.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no -- commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,ts,mjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.vue": [
      "oxlint --fix",
      "eslint --fix",
      "stylelint --fix"
    ],
    "*.{css,scss}": [
      "stylelint --fix"
    ],
    "*.{json,md,yaml}": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@10.33.4"
}
